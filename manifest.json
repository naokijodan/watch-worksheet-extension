{
  "manifest_version": 3,
  "name": "Watch Worksheet作成君",
  "version": "1.1.0",
  "description": "FedEx新形式 時計税関ワークシートをChatGPTデータから生成してPDFダウンロード",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": ["<all_urls>", "https://api.openai.com/"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Watch Worksheet作成君",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
